AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Claude (única com busca na web e fontes)
ANTHROPIC_API_KEY=

# Grok (xAI)
XAI_API_KEY=

# OpenAI (precisa de AI_MODEL)
OPENAI_API_KEY=
